# ---- Model Gateway ----
LITELLM_MASTER_KEY=sk-change-me
OPENAI_API_KEY=            # 可选，走云端模型时填
# 私有模型示例
# OPENAI_API_BASE=http://vllm:8000/v1

# ---- Core ----
DATABASE_URL=postgresql://wardrail:wardrail@postgres:5432/wardrail
REDIS_URL=redis://redis:6379/0
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root

# ---- Security ----
DLP_MODE=mask              # mask | block
HITL_TIMEOUT_SECONDS=3600
SANDBOX_RUNTIME=docker     # docker | gvisor
AUDIT_SINK=postgres        # postgres | kafka
